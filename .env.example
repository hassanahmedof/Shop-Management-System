# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# OWNER_EMAIL: Required server-side Google email address authorized for Owner/Admin login.
# Only the Google account with this exact email can access the Owner/Admin panel.
# Configure this in your server environment or AI Studio Secrets panel.
OWNER_EMAIL=""

# OWNER_GATE_SECRET: Required server secret (>= 32 random chars) for owner setup proof hashing.
# Configure this in the AI Studio Secrets panel. Never expose to frontend code.
OWNER_GATE_SECRET=""

# SESSION_SECRET: Required server secret (>= 32 random chars) for HMAC signing session cookies.
# Configure this in the AI Studio Secrets panel. Never expose to frontend code.
SESSION_SECRET=""

# GOOGLE_SERVICE_ACCOUNT_JSON: Optional server-side Google Cloud Service Account JSON key
# (recommended when the Owner Google account uses Advanced Protection Program, or for 24/7 background sync).
# Never expose this value in frontend code.
GOOGLE_SERVICE_ACCOUNT_JSON=""

# GOOGLE_SPREADSHEET_ID: Optional existing Google Spreadsheet ID shared with the Service Account (as Editor).
GOOGLE_SPREADSHEET_ID=""

# SERVICE_ACCOUNT_ENCRYPTION_KEY: Required server secret (>= 32 random chars) used with HKDF-SHA256
# to encrypt optional server credential vaults at rest. Configure in AI Studio Secrets panel.
SERVICE_ACCOUNT_ENCRYPTION_KEY=""

# LEGACY_ENCRYPTION_KEYS: Optional comma-separated previous SERVICE_ACCOUNT_ENCRYPTION_KEY values
# used only during key rotation to decrypt and upgrade older vault files safely.
LEGACY_ENCRYPTION_KEYS=""

# DISCORD_WEBHOOK_URL: Optional server-side Discord Incoming Webhook URL.
# When configured, CareMart automatically sends notifications to Discord whenever
# a Sale, Purchase, or Expense is saved. Never expose this value in frontend code.
DISCORD_WEBHOOK_URL=""
