        && data.productId is string && isValidId(data.productId)
        && data.productName is string && data.productName.size() >= 1 && data.productName.size() <= 180
        && data.unitName is string && data.unitName.size() >= 1 && data.unitName.size() <= 40
        && data.conversionFactor is number && data.conversionFactor > 0 && data.conversionFactor <= 100000
        && data.quantity is number && data.quantity > 0 && data.quantity <= 10000
        && data.baseQuantity is number && data.baseQuantity > 0 && data.baseQuantity <= 1000000
        && data.baseQuantity <= data.quantity * data.conversionFactor + 0.005
        && data.baseQuantity >= data.quantity * data.conversionFactor - 0.005
        && data.unitPrice is number && data.unitPrice >= 0 && data.unitPrice <= 10000000
        && data.lineTotal is number && data.lineTotal >= 0 && data.lineTotal <= 10000000
        && data.lineTotal <= data.unitPrice * data.quantity + 0.01
        && data.lineTotal >= data.unitPrice * data.quantity - 0.01
        && data.createdAt is timestamp;
    }

    function isValidWebsiteOrderCore(data, shopId) {
      return data.ownerUid is string && data.ownerUid == shopId && data.ownerUid.size() <= 128
        && data.shopId is string && data.shopId == shopId && data.shopId.size() <= 128
        && data.orderNumber is string && data.orderNumber.size() >= 3 && data.orderNumber.size() <= 40
        && data.customerName is string && data.customerName.size() >= 2 && data.customerName.size() <= 120
        && data.customerPhone is string && data.customerPhone.size() >= 7 && data.customerPhone.size() <= 24
        && data.customerPhone.matches('^[0-9+\\-() ]{7,24}$')
        && data.customerAddress is string && data.customerAddress.size() >= 5 && data.customerAddress.size() <= 400
        && data.customerNotes is string && data.customerNotes.size() <= 500
        && data.paymentMethod == 'Cash on Delivery'
        && data.itemCount is number && data.itemCount >= 1 && data.itemCount <= 50
        && data.totalQuantity is number && data.totalQuantity > 0 && data.totalQuantity <= 100000
        && data.subtotal is number && data.subtotal >= 0 && data.subtotal <= 10000000
        && data.deliveryFee is number && data.deliveryFee >= 0 && data.deliveryFee <= 100000
        && data.totalAmount is number && data.totalAmount >= 0 && data.totalAmount <= 10100000
        && data.totalAmount >= data.subtotal
        && data.totalAmount <= data.subtotal + data.deliveryFee + 0.01
        && data.totalAmount >= data.subtotal + data.deliveryFee - 0.01
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidWebsiteOrderCreate(data, shopId) {
      return data.keys().hasAll([
          'ownerUid', 'shopId', 'orderNumber', 'customerName', 'customerPhone',
          'customerAddress', 'customerNotes', 'paymentMethod', 'status',
          'itemCount', 'totalQuantity', 'subtotal', 'deliveryFee',
          'totalAmount', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerUid', 'shopId', 'orderNumber', 'customerName', 'customerPhone',
          'customerAddress', 'customerNotes', 'paymentMethod', 'status',
          'itemCount', 'totalQuantity', 'subtotal', 'deliveryFee',
          'totalAmount', 'createdAt', 'updatedAt'
        ])
        && data.status == 'Pending Confirmation'
        && isValidWebsiteOrderCore(data, shopId);
    }

    function isValidWebsiteOrderUpdate(data, shopId) {
      return data.keys().hasAll([
          'ownerUid', 'shopId', 'orderNumber', 'customerName', 'customerPhone',
          'customerAddress', 'customerNotes', 'paymentMethod', 'status',
          'itemCount', 'totalQuantity', 'subtotal', 'deliveryFee',
          'totalAmount', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerUid', 'shopId', 'orderNumber', 'customerName', 'customerPhone',
          'customerAddress', 'customerNotes', 'paymentMethod', 'status',
          'items', 'itemCount', 'totalQuantity', 'subtotal', 'deliveryFee',
          'totalAmount', 'linkedSaleId', 'linkedSaleNumber', 'rejectionReason',
          'confirmedBy', 'confirmedByName', 'confirmedAt', 'outForDeliveryAt',
          'deliveredAt', 'cancelledAt', 'createdAt', 'updatedAt'
        ])
        && data.status is string && data.status in [
          'Pending Confirmation', 'Confirmed', 'Out for Delivery', 'Delivered', 'Cancelled/Rejected'
        ]
        && (!('linkedSaleId' in data) || (data.linkedSaleId is string && isValidId(data.linkedSaleId)))
        && (!('linkedSaleNumber' in data) || (data.linkedSaleNumber is string && data.linkedSaleNumber.size() >= 1 && data.linkedSaleNumber.size() <= 40))
        && (!('rejectionReason' in data) || (data.rejectionReason is string && data.rejectionReason.size() >= 1 && data.rejectionReason.size() <= 300))
        && (!('confirmedBy' in data) || (data.confirmedBy is string && data.confirmedBy.size() >= 1 && data.confirmedBy.size() <= 128))
        && (!('confirmedByName' in data) || (data.confirmedByName is string && data.confirmedByName.size() >= 1 && data.confirmedByName.size() <= 120))
        && (!('confirmedAt' in data) || data.confirmedAt is timestamp)
        && (!('outForDeliveryAt' in data) || data.outForDeliveryAt is timestamp)
        && (!('deliveredAt' in data) || data.deliveredAt is timestamp)
        && (!('cancelledAt' in data) || data.cancelledAt is timestamp)
        && isValidWebsiteOrderCore(data, shopId);
    }

    // ------------------------------------------------------------------
    // Single-Owner Initial Setup Lock (Zero PII)
    // ------------------------------------------------------------------
    match /appState/{stateId} {
      allow get: if stateId == 'ownerSetup';
      allow list: if false;
      allow create: if isOwnerAuthUser()
        && isNotStaffAccount(request.auth.uid)
        && stateId == 'ownerSetup'
        && !exists(/databases/$(database)/documents/appState/ownerSetup)
        && isValidOwnerSetupState(incoming())
        && incoming().createdAt == request.time;
      allow update, delete: if false;
    }

    // ------------------------------------------------------------------
    // Authorized Admins Collection (Server-Proof & Single-Owner Gate, No Staff Escalation)
    // ------------------------------------------------------------------
    match /admins/{adminUid} {
      allow get: if isOwnerAuthUser()
        && isValidId(adminUid)
        && adminUid == request.auth.uid
        && (resource == null || existing().email == request.auth.token.email.lower());
      allow list: if false;
      allow create: if isOwnerAuthUser()
        && isNotStaffAccount(request.auth.uid)
        && isOwnerSetupAuthorizedFor(request.auth.uid)
        && isValidId(adminUid)
        && adminUid == request.auth.uid
        && isValidAdminRecord(incoming())
        && incoming().ownerProof == hashing.sha256(request.auth.uid + ':' + request.auth.token.email.lower() + ':' + gateSecret()).toHexString().lower()
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update, delete: if false;
    }

    // ------------------------------------------------------------------
    // Users Collection (PII Isolated to Authorized Owner/Admins Only)
    // ------------------------------------------------------------------
    match /users/{userId} {
      allow get: if isOwnerAuthUser()
        && isNotStaffAccount(request.auth.uid)
        && isValidId(userId)
        && userId == request.auth.uid
        && (isAuthorizedAdminDoc(request.auth.uid) || exists(/databases/$(database)/documents/adminAuthMap/$(request.auth.uid)));
      allow list: if false;
      allow create: if isOwnerAuthUser()
        && isNotStaffAccount(request.auth.uid)
        && isValidId(userId)
        && userId == request.auth.uid
        && (isAuthorizedAdminDoc(request.auth.uid) || exists(/databases/$(database)/documents/adminAuthMap/$(request.auth.uid)))
        && isValidUserProfile(incoming())
        && incoming().role in ['owner', 'admin']
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isOwnerAuthUser()
        && isNotStaffAccount(request.auth.uid)
        && isValidId(userId)
        && userId == request.auth.uid
        && (isAuthorizedAdminDoc(request.auth.uid) || exists(/databases/$(database)/documents/adminAuthMap/$(request.auth.uid)))
        && isValidUserProfile(incoming())
        && incoming().uid == existing().uid
        && incoming().role == existing().role
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'email', 'updatedAt']);
      allow delete: if false;
    }

    // ------------------------------------------------------------------
    // Admin Lookup & Auth Mapping (Username-based Added Admins, Created Only by Existing Admins)
    // ------------------------------------------------------------------
    match /adminLookup/{lookupKey} {
      // Exact key lookup only (no PII, no listing/enumeration)
      allow get: if isValidId(lookupKey);
      allow list: if false;
      allow create: if isValidId(lookupKey)
        && isValidAdminLookup(incoming())
        && isOwner(incoming().shopId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && shopExists(incoming().shopId);
      allow update: if isValidId(lookupKey)
        && isValidAdminLookup(incoming())
        && isOwner(existing().shopId)
        && incoming().ownerUid == existing().ownerUid
        && incoming().shopId == existing().shopId
        && incoming().adminMemberId == existing().adminMemberId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['loginVersion', 'isActive', 'updatedAt']);
      allow delete: if isValidId(lookupKey) && isOwner(existing().shopId);
    }

    match /adminAuthMap/{authUid} {
      allow get: if isValidId(authUid) && (
        (isOwnerAuthUser() && isNotStaffAccount(request.auth.uid) && request.auth.uid == authUid) ||
        (resource != null && isOwner(existing().shopId))
      );
      allow list: if false;
      allow create: if isValidId(authUid)
        && isValidAdminAuthMap(incoming())
        && isOwner(incoming().shopId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && shopExists(incoming().shopId);
      allow update: if isValidId(authUid)
        && isValidAdminAuthMap(incoming())
        && isOwner(existing().shopId)
        && incoming().ownerUid == existing().ownerUid
        && incoming().shopId == existing().shopId
        && incoming().adminMemberId == existing().adminMemberId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['isActive', 'updatedAt']);
      allow delete: if isValidId(authUid) && isOwner(existing().shopId);
    }

    // ------------------------------------------------------------------
    // Staff Lookup & Auth Mapping (Database-Level RBAC)
    // ------------------------------------------------------------------
    match /staffLookup/{lookupKey} {
      // Exact key lookup only (no PII, no listing/enumeration)
      allow get: if isValidId(lookupKey);
      allow list: if false;
      allow create: if isValidId(lookupKey)
        && isValidStaffLookup(incoming())
        && isOwner(incoming().shopId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && shopExists(incoming().shopId);
      allow update: if isValidId(lookupKey)
        && isValidStaffLookup(incoming())
        && isOwner(existing().shopId)
        && incoming().ownerUid == existing().ownerUid
        && incoming().shopId == existing().shopId
        && incoming().staffId == existing().staffId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['loginVersion', 'isActive', 'updatedAt']);
      allow delete: if isValidId(lookupKey) && isOwner(existing().shopId);
    }

    match /staffAuthMap/{authUid} {
      allow get: if isValidId(authUid) && (
        (resource != null && isOwner(existing().shopId)) ||
        (isStaffPasswordUser() && request.auth.uid == authUid)
      );
      allow list: if false;
      allow create: if isValidId(authUid)
        && isValidStaffAuthMap(incoming())
        && isOwner(incoming().shopId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && shopExists(incoming().shopId);
      allow update: if isValidId(authUid)
        && isValidStaffAuthMap(incoming())
        && isOwner(existing().shopId)
        && incoming().ownerUid == existing().ownerUid
        && incoming().shopId == existing().shopId
        && incoming().staffId == existing().staffId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['isActive', 'updatedAt']);
      allow delete: if isValidId(authUid) && isOwner(existing().shopId);
    }

    // ------------------------------------------------------------------
    // Shops Root & Subcollections
    // ------------------------------------------------------------------
    match /shops/{shopId} {
      allow get: if isOwner(shopId) && isValidId(shopId) && (resource == null || existing().ownerUid == shopId);
      allow list: if isOwner(shopId) && existing().ownerUid == shopId;
      allow create: if isPrimaryOwner(shopId)
        && isValidId(shopId)
        && isValidShop(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isOwner(shopId)
        && isValidId(shopId)
        && isValidShop(incoming())
        && incoming().ownerUid == existing().ownerUid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['shopName', 'updatedAt']);
      allow delete: if false;

      // Added Admin Members (Managed by existing Shop Owner / Admins)
      match /adminMembers/{adminMemberId} {
        allow get: if isValidId(adminMemberId) && isOwner(shopId) && (resource == null || (shopExists(shopId) && existing().ownerUid == shopId));
        allow list: if isOwner(shopId) && existing().ownerUid == shopId;
        allow create: if isOwner(shopId)
          && isValidId(adminMemberId)
          && isValidAdminMember(incoming(), shopId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && shopExists(shopId);
        allow update: if isOwner(shopId)
          && isValidId(adminMemberId)
          && isValidAdminMember(incoming(), shopId)
          && existing().ownerUid == shopId
          && incoming().ownerUid == existing().ownerUid
          && incoming().shopId == existing().shopId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && shopExists(shopId)
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'name', 'phone', 'authUid', 'loginVersion', 'isActive', 'updatedAt'
          ]);
        allow delete: if isOwner(shopId) && isValidId(adminMemberId) && shopExists(shopId) && existing().ownerUid == shopId;
      }

      // Staff Accounts (Owner/Admins manage; active staff can read ONLY their own staff record)
      match /staff/{staffId} {
        allow get: if isValidId(staffId) && (
          (isOwner(shopId) && (resource == null || (shopExists(shopId) && existing().ownerUid == shopId))) ||
          (isActiveStaffOf(shopId) && existing().authUid == request.auth.uid && existing().isActive == true)
        );
        allow list: if isOwner(shopId) && existing().ownerUid == shopId;
        allow create: if isOwner(shopId)
          && isValidId(staffId)
          && isValidStaffMember(incoming(), shopId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && shopExists(shopId);
        allow update: if isOwner(shopId)
          && isValidId(staffId)
          && isValidStaffMember(incoming(), shopId)
          && existing().ownerUid == shopId
          && incoming().ownerUid == existing().ownerUid
          && incoming().shopId == existing().shopId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && shopExists(shopId)
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'name', 'phone', 'authUid', 'loginVersion', 'isActive', 'permissions', 'updatedAt'
          ]);
        allow delete: if isOwner(shopId) && isValidId(staffId) && shopExists(shopId) && existing().ownerUid == shopId;
      }

      // Sanitized Staff Product Catalog (No purchase prices or profit margins)
      match /staffCatalog/{productId} {
        allow get: if isValidId(productId) && (
          (isOwner(shopId) && (resource == null || existing().ownerUid == shopId)) ||
          (isActiveStaffOf(shopId) && existing().ownerUid == shopId && request.auth.uid in existing().allowedStaffUids)
        );
        // Zero get()/exists() in allow list for staff: staff queries filter array-contains request.auth.uid
        allow list: if (isOwner(shopId) && existing().ownerUid == shopId)
          || (isStaffPasswordUser() && request.auth.uid in existing().allowedStaffUids);
        allow create: if isOwner(shopId)
          && isValidId(productId)
          && isValidStaffCatalogItem(incoming(), shopId)
          && incoming().updatedAt == request.time
          && shopExists(shopId);
        allow update: if isValidId(productId)
          && isValidStaffCatalogItem(incoming(), shopId)
          && incoming().ownerUid == existing().ownerUid
          && incoming().productId == existing().productId
          && incoming().updatedAt == request.time
          && (
            isOwner(shopId) ||
            (
              staffCanAddSales(shopId)
              && request.auth.uid in existing().allowedStaffUids
              && existing().isActive == true
              && incoming().diff(existing()).affectedKeys().hasOnly(['currentStock', 'updatedAt'])
              && incoming().currentStock < existing().currentStock
              && incoming().currentStock >= 0
            )
          );
        allow delete: if isOwner(shopId) && isValidId(productId) && shopExists(shopId) && existing().ownerUid == shopId;
      }

      // Staff Sales Ledger (Staff can create & read ONLY their own; never edit or delete; no cost/profit fields)
      match /staffSales/{saleId} {
        allow get: if isValidId(saleId) && (
          (isOwner(shopId) && (resource == null || existing().ownerUid == shopId)) ||
          (isActiveStaffOf(shopId) && existing().staffAuthUid == request.auth.uid && existing().ownerUid == shopId)
        );
        // Zero get()/exists() in allow list for staff: staff queries filter where staffAuthUid == request.auth.uid
        allow list: if (isOwner(shopId) && existing().ownerUid == shopId)
          || (isStaffPasswordUser() && existing().staffAuthUid == request.auth.uid);
        allow create: if isValidId(saleId)
          && isValidStaffSale(incoming(), shopId)
          && incoming().status == 'completed'
          && incoming().syncedToLedger == false
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && staffCanAddSales(shopId)
          && incoming().staffAuthUid == request.auth.uid;
        allow update: if isOwner(shopId)
          && isValidId(saleId)
          && isValidStaffSale(incoming(), shopId)
          && incoming().ownerUid == existing().ownerUid
          && incoming().shopId == existing().shopId
          && incoming().staffId == existing().staffId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'syncedToLedger', 'status', 'notes', 'saleDate', 'paymentMethod',
            'totalAmount', 'totalQuantity', 'itemCount', 'items', 'customerWhatsapp', 'updatedAt'
          ]);
        allow delete: if false;
      }

      match /settings/{settingId} {
        allow get: if isOwner(shopId) && isValidId(settingId) && (resource == null || (shopExists(shopId) && existing().ownerUid == shopId));
        allow list: if isOwner(shopId) && existing().ownerUid == shopId;
        allow create: if isOwner(shopId)
          && isValidId(settingId)
          && isValidShopSettings(incoming(), shopId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && shopExists(shopId);
        allow update: if isOwner(shopId)
          && isValidId(settingId)
          && isValidShopSettings(incoming(), shopId)
          && incoming().ownerUid == existing().ownerUid
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && shopExists(shopId)
          && (
            incoming().diff(existing()).affectedKeys().hasOnly([
              'shopName', 'ownerName', 'phone', 'address',
              'expiryAlertDays', 'autoBackupEnabled', 'updatedAt'
            ]) ||
            incoming().diff(existing()).affectedKeys().hasOnly(['lastBackupAt', 'updatedAt'])
          );
        allow delete: if false;
      }

      match /categories/{categoryId} {
        allow get: if isOwner(shopId) && isValidId(categoryId) && (resource == null || (shopExists(shopId) && existing().ownerUid == shopId));
        allow list: if isOwner(shopId) && existing().ownerUid == shopId;
        allow create: if isOwner(shopId)
          && isValidId(categoryId)
          && isValidCategory(incoming(), shopId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && shopExists(shopId);
        allow update: if isOwner(shopId)
          && isValidId(categoryId)
          && isValidCategory(incoming(), shopId)
          && incoming().ownerUid == existing().ownerUid
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && shopExists(shopId)
          && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'description', 'updatedAt']);
        allow delete: if isOwner(shopId) && isValidId(categoryId) && shopExists(shopId) && existing().ownerUid == shopId;
      }

      match /brands/{brandId} {
        allow get: if isOwner(shopId) && isValidId(brandId) && (resource == null || (shopExists(shopId) && existing().ownerUid == shopId));
        allow list: if isOwner(shopId) && existing().ownerUid == shopId;
        allow create: if isOwner(shopId)
          && isValidId(brandId)
          && isValidBrand(incoming(), shopId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && shopExists(shopId);
        allow update: if isOwner(shopId)
          && isValidId(brandId)
          && isValidBrand(incoming(), shopId)
          && incoming().ownerUid == existing().ownerUid
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && shopExists(shopId)
          && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'categoryIds', 'isActive', 'updatedAt']);
        allow delete: if isOwner(shopId) && isValidId(brandId) && shopExists(shopId) && existing().ownerUid == shopId;
      }

      match /suppliers/{supplierId} {
        allow get: if isOwner(shopId) && isValidId(supplierId) && (resource == null || (shopExists(shopId) && existing().ownerUid == shopId));
        allow list: if isOwner(shopId) && existing().ownerUid == shopId;
        allow create: if isOwner(shopId)
          && isValidId(supplierId)
          && isValidSupplier(incoming(), shopId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && shopExists(shopId);
        allow update: if isOwner(shopId)
          && isValidId(supplierId)
          && isValidSupplier(incoming(), shopId)
          && incoming().ownerUid == existing().ownerUid
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && shopExists(shopId)
          && (
            incoming().diff(existing()).affectedKeys().hasOnly(['name', 'phone', 'address', 'email', 'notes', 'updatedAt']) ||
            incoming().diff(existing()).affectedKeys().hasOnly(['totalPurchased', 'totalPaid', 'outstandingBalance', 'updatedAt'])
          );
        allow delete: if isOwner(shopId) && isValidId(supplierId) && shopExists(shopId) && existing().ownerUid == shopId;
      }

      match /products/{productId} {
        allow get: if isOwner(shopId) && isValidId(productId) && (resource == null || (shopExists(shopId) && existing().ownerUid == shopId));
        allow list: if isOwner(shopId) && existing().ownerUid == shopId;
        allow create: if isOwner(shopId)
          && isValidId(productId)
          && isValidProduct(incoming(), shopId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && shopExists(shopId);
        allow update: if isOwner(shopId)
          && isValidId(productId)
          && isValidProduct(incoming(), shopId)
          && incoming().ownerUid == existing().ownerUid
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && shopExists(shopId)
          && (
            incoming().diff(existing()).affectedKeys().hasOnly([
              'name', 'categoryId', 'categoryName', 'brandId', 'brandName',
              'purchasePrice', 'salePrice', 'wholesalePrice',
              'minStockLevel', 'maxStockLevel', 'unit',
              'baseUnit', 'packagingUnits', 'originType', 'bottleSize', 'storageLocation',
              'isReturnable', 'returnableUnitName', 'depositPerReturnable', 'emptyContainersOnHand',
              'supplierId', 'supplierName', 'expiryDate', 'profitMarginPct', 'image',
              'isActive', 'updatedAt'
            ]) ||
            incoming().diff(existing()).affectedKeys().hasOnly([
              'currentStock', 'purchasePrice', 'profitMarginPct', 'updatedAt'
            ]) ||
            incoming().diff(existing()).affectedKeys().hasOnly([
              'currentStock', 'emptyContainersOnHand', 'updatedAt'
            ]) ||
            incoming().diff(existing()).affectedKeys().hasOnly([
              'currentStock', 'updatedAt'
            ])
          );
        allow delete: if isOwner(shopId) && isValidId(productId) && shopExists(shopId) && existing().ownerUid == shopId;
      }

      match /sales/{saleId} {
        allow get: if isOwner(shopId) && isValidId(saleId) && (resource == null || (shopExists(shopId) && existing().ownerUid == shopId));
        allow list: if isOwner(shopId) && existing().ownerUid == shopId;
        allow create: if isOwner(shopId)
          && isValidId(saleId)
          && isValidSale(incoming(), shopId)
          && incoming().status == 'completed'
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && shopExists(shopId);
        allow update: if isOwner(shopId)
          && isValidId(saleId)
          && isValidSale(incoming(), shopId)
          && existing().status != 'cancelled'
          && incoming().ownerUid == existing().ownerUid
          && incoming().saleNumber == existing().saleNumber
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && shopExists(shopId)
          && (
            (incoming().status == 'completed' && incoming().diff(existing()).affectedKeys().hasOnly([
              'saleDate', 'paymentMethod', 'totalAmount', 'totalCost', 'totalProfit',
              'totalQuantity', 'itemCount', 'customerWhatsapp', 'notes', 'updatedAt'
            ])) ||
            (incoming().status == 'cancelled' && incoming().diff(existing()).affectedKeys().hasOnly([
              'status', 'notes', 'updatedAt'
            ]))
          );
        allow delete: if false;
      }

      match /saleItems/{saleItemId} {
        allow get: if isOwner(shopId) && isValidId(saleItemId) && (resource == null || (shopExists(shopId) && existing().ownerUid == shopId));
        allow list: if isOwner(shopId) && existing().ownerUid == shopId;
        allow create: if isOwner(shopId)
          && isValidId(saleItemId)
          && isValidSaleItem(incoming(), shopId)
          && incoming().status == 'completed'
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && shopExists(shopId);
        allow update: if isOwner(shopId)
          && isValidId(saleItemId)
          && isValidSaleItem(incoming(), shopId)
          && existing().status != 'cancelled'
          && incoming().ownerUid == existing().ownerUid
          && incoming().saleId == existing().saleId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && shopExists(shopId)
          && (
            (incoming().status == 'completed' && incoming().diff(existing()).affectedKeys().hasOnly([
              'saleDate', 'quantity', 'unitName', 'unitQuantity', 'conversionFactor', 'baseQuantity',
              'salePricePerUnit', 'purchasePriceAtSale', 'lineTotal', 'lineCost', 'lineProfit',
              'batchAllocations', 'updatedAt'
            ])) ||
            (incoming().status == 'cancelled' && incoming().diff(existing()).affectedKeys().hasOnly([
              'status', 'updatedAt'
            ]))
          );
        allow delete: if isOwner(shopId) && isValidId(saleItemId) && shopExists(shopId) && existing().ownerUid == shopId;
      }

      match /purchases/{purchaseId} {
        allow get: if isOwner(shopId) && isValidId(purchaseId) && (resource == null || (shopExists(shopId) && existing().ownerUid == shopId));
        allow list: if isOwner(shopId) && existing().ownerUid == shopId;
        allow create: if isOwner(shopId)
          && isValidId(purchaseId)
          && isValidPurchase(incoming(), shopId)
          && incoming().status == 'completed'
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && shopExists(shopId);
        allow update: if isOwner(shopId)
          && isValidId(purchaseId)
          && isValidPurchase(incoming(), shopId)
          && existing().status != 'cancelled'
          && incoming().ownerUid == existing().ownerUid
          && incoming().purchaseNumber == existing().purchaseNumber
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && shopExists(shopId)
          && (
            (incoming().status == 'completed' && incoming().diff(existing()).affectedKeys().hasOnly([
              'amountPaid', 'balanceDue', 'paymentMethod', 'notes', 'updatedAt'
            ])) ||
            (incoming().status == 'cancelled' && incoming().diff(existing()).affectedKeys().hasOnly([
              'status', 'notes', 'updatedAt'
            ]))
          );
        allow delete: if false;
      }

      match /purchaseItems/{purchaseItemId} {
        allow get: if isOwner(shopId) && isValidId(purchaseItemId) && (resource == null || (shopExists(shopId) && existing().ownerUid == shopId));
        allow list: if isOwner(shopId) && existing().ownerUid == shopId;
        allow create: if isOwner(shopId)
          && isValidId(purchaseItemId)
          && isValidPurchaseItem(incoming(), shopId)
          && incoming().status == 'completed'
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && shopExists(shopId);
        allow update: if isOwner(shopId)
          && isValidId(purchaseItemId)
          && isValidPurchaseItem(incoming(), shopId)
          && existing().status != 'cancelled'
          && incoming().ownerUid == existing().ownerUid
          && incoming().purchaseId == existing().purchaseId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && shopExists(shopId)
          && incoming().status == 'cancelled'
          && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']);
        allow delete: if false;
      }

      match /expenseCategories/{expenseCategoryId} {
        allow get: if isOwner(shopId) && isValidId(expenseCategoryId) && (resource == null || (shopExists(shopId) && existing().ownerUid == shopId));
        allow list: if isOwner(shopId) && existing().ownerUid == shopId;
        allow create: if isOwner(shopId)
          && isValidId(expenseCategoryId)
          && isValidExpenseCategory(incoming(), shopId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && shopExists(shopId);
        allow update: if isOwner(shopId)
          && isValidId(expenseCategoryId)
          && isValidExpenseCategory(incoming(), shopId)
          && incoming().ownerUid == existing().ownerUid
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && shopExists(shopId)
          && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'updatedAt']);
        allow delete: if isOwner(shopId) && isValidId(expenseCategoryId) && shopExists(shopId) && existing().ownerUid == shopId && existing().isDefault == false;
      }

      match /expenses/{expenseId} {
        allow get: if isOwner(shopId) && isValidId(expenseId) && (resource == null || (shopExists(shopId) && existing().ownerUid == shopId));
        allow list: if isOwner(shopId) && existing().ownerUid == shopId;
        allow create: if isOwner(shopId)
          && isValidId(expenseId)
          && isValidExpense(incoming(), shopId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && shopExists(shopId);
        allow update: if isOwner(shopId)
          && isValidId(expenseId)
          && isValidExpense(incoming(), shopId)
          && incoming().ownerUid == existing().ownerUid
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && shopExists(shopId)
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'title', 'categoryId', 'categoryName', 'amount', 'expenseDate',
            'paymentMethod', 'notes', 'updatedAt'
          ]);
        allow delete: if isOwner(shopId) && isValidId(expenseId) && shopExists(shopId) && existing().ownerUid == shopId;
      }

      match /stockMovements/{movementId} {
        allow get: if isOwner(shopId) && isValidId(movementId) && (resource == null || (shopExists(shopId) && existing().ownerUid == shopId));
        allow list: if isOwner(shopId) && existing().ownerUid == shopId;
        allow create: if isOwner(shopId)
          && isValidId(movementId)
          && isValidStockMovement(incoming(), shopId)
          && incoming().createdAt == request.time
          && shopExists(shopId);
        allow update, delete: if false;
      }

      match /stockAdjustments/{adjustmentId} {
        allow get: if isOwner(shopId) && isValidId(adjustmentId) && (resource == null || (shopExists(shopId) && existing().ownerUid == shopId));
        allow list: if isOwner(shopId) && existing().ownerUid == shopId;
        allow create: if isOwner(shopId)
          && isValidId(adjustmentId)
          && isValidStockAdjustment(incoming(), shopId)
          && incoming().createdAt == request.time
          && shopExists(shopId);
        allow update, delete: if false;
      }

      match /inventoryBatches/{batchId} {
        allow get: if isOwner(shopId) && isValidId(batchId) && (resource == null || (shopExists(shopId) && existing().ownerUid == shopId));
        allow list: if isOwner(shopId) && existing().ownerUid == shopId;
        allow create: if isOwner(shopId)
          && isValidId(batchId)
          && isValidInventoryBatch(incoming(), shopId)
          && incoming().status == 'active'
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && shopExists(shopId);
        allow update: if isOwner(shopId)
          && isValidId(batchId)
          && isValidInventoryBatch(incoming(), shopId)
          && existing().status != 'cancelled'
          && incoming().ownerUid == existing().ownerUid
          && incoming().productId == existing().productId
          && incoming().purchaseId == existing().purchaseId
          && incoming().initialBaseQty == existing().initialBaseQty
          && incoming().unitCostInBase == existing().unitCostInBase
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && shopExists(shopId)
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'remainingBaseQty', 'status', 'updatedAt'
          ]);
        allow delete: if false;
      }

      match /auditLogs/{logId} {
        allow get: if isOwner(shopId) && isValidId(logId) && (resource == null || (shopExists(shopId) && existing().ownerUid == shopId));
        allow list: if isOwner(shopId) && existing().ownerUid == shopId;
        allow create: if isValidId(logId)
          && isValidAuditLog(incoming(), shopId)
          && incoming().createdAt == request.time
          && shopExists(shopId)
          && (
            isOwner(shopId) ||
            (
              isActiveStaffOf(shopId)
              && incoming().action == 'STAFF_LOGIN'
              && incoming().entityType == 'staff'
              && isValidId(incoming().entityId)
              && incoming().entityId == get(/databases/$(database)/documents/staffAuthMap/$(request.auth.uid)).data.staffId
              && get(/databases/$(database)/documents/shops/$(shopId)/staff/$(incoming().entityId)).data.isActive == true
              && get(/databases/$(database)/documents/shops/$(shopId)/staff/$(incoming().entityId)).data.authUid == request.auth.uid
            )
          );
        allow update, delete: if false;
      }

      match /backups/{backupId} {
        allow get: if isOwner(shopId) && isValidId(backupId) && (resource == null || (shopExists(shopId) && existing().ownerUid == shopId));
        allow list: if isOwner(shopId) && existing().ownerUid == shopId;
        allow create: if isOwner(shopId)
          && isValidId(backupId)
          && isValidBackupRecord(incoming(), shopId)
          && incoming().createdAt == request.time
          && shopExists(shopId);
        allow update, delete: if false;
      }

      match /integrations/{integrationId} {
        allow get: if isOwner(shopId) && isValidId(integrationId) && (resource == null || (shopExists(shopId) && existing().ownerUid == shopId));
        allow list: if isOwner(shopId) && existing().ownerUid == shopId;
        allow create: if isOwner(shopId)
          && isValidId(integrationId)
          && isValidGoogleSheetsIntegration(incoming(), shopId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && shopExists(shopId);
        allow update: if isOwner(shopId)
          && isValidId(integrationId)
          && isValidGoogleSheetsIntegration(incoming(), shopId)
          && existing().ownerUid == shopId
          && incoming().ownerUid == existing().ownerUid
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && shopExists(shopId)
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'spreadsheetId', 'spreadsheetUrl', 'spreadsheetTitle',
            'autoSyncEnabled', 'connectionState', 'lastSyncAt', 'lastSyncStatus',
            'lastError', 'syncedRecordCount', 'updatedAt'
          ]);
        allow delete: if false;
      }

      match /sheetsSyncQueue/{jobId} {
        allow get: if isOwner(shopId) && isValidId(jobId) && (resource == null || (shopExists(shopId) && existing().ownerUid == shopId));
        allow list: if isOwner(shopId) && existing().ownerUid == shopId;
        allow create: if isOwner(shopId)
          && isValidId(jobId)
          && isValidSheetsSyncJob(incoming(), shopId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && shopExists(shopId);
        allow update: if isOwner(shopId)
          && isValidId(jobId)
          && isValidSheetsSyncJob(incoming(), shopId)
          && existing().ownerUid == shopId
          && incoming().ownerUid == existing().ownerUid
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && shopExists(shopId)
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'targetSheets', 'recordCount', 'status', 'retryCount', 'lastError', 'summary', 'updatedAt'
          ]);
        allow delete: if isOwner(shopId) && isValidId(jobId) && shopExists(shopId) && existing().ownerUid == shopId;
      }

      match /productTemplates/{templateId} {
        allow get: if isOwner(shopId) && isValidId(templateId) && (resource == null || (shopExists(shopId) && existing().ownerUid == shopId));
        allow list: if isOwner(shopId) && existing().ownerUid == shopId;
        allow create: if isOwner(shopId)
          && isValidId(templateId)
          && isValidProductTemplate(incoming(), shopId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && shopExists(shopId);
        allow update: if isOwner(shopId)
          && isValidId(templateId)
          && isValidProductTemplate(incoming(), shopId)
          && incoming().ownerUid == existing().ownerUid
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && shopExists(shopId)
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'name', 'categoryId', 'categoryName', 'brandId', 'brandName',
            'variant', 'originType', 'baseUnit', 'defaultPurchaseUnit', 'defaultSaleUnit',
            'packagingUnits', 'hasUnconfirmedPackaging',
            'suggestedPurchasePrice', 'suggestedSalePrice', 'suggestedWholesalePrice',
            'priceSource', 'priceUpdatedAt', 'trackExpiry', 'bottleSize', 'storageLocation',
            'isReturnable', 'returnableUnitName', 'searchKeywords',
            'isActive', 'isCustom', 'updatedAt'
          ]);
        allow delete: if isOwner(shopId) && isValidId(templateId) && shopExists(shopId) && existing().ownerUid == shopId;
      }

      match /upsellCache/{cacheId} {
        allow get: if isValidId(cacheId)
          && cacheId == 'cooccurrence_v2'
          && (
            (isOwner(shopId) && (resource == null || (shopExists(shopId) && existing().ownerUid == shopId))) ||
            (staffCanAddSales(shopId) && shopExists(shopId) && (resource == null || existing().ownerUid == shopId))
          );
        allow list: if false;
        allow create: if isOwner(shopId)
          && isValidId(cacheId)
          && cacheId == 'cooccurrence_v2'
          && isValidUpsellCooccurrenceCache(incoming(), shopId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && shopExists(shopId);
        allow update: if isOwner(shopId)
          && isValidId(cacheId)
          && cacheId == 'cooccurrence_v2'
          && isValidUpsellCooccurrenceCache(incoming(), shopId)
          && existing().ownerUid == shopId
          && incoming().ownerUid == existing().ownerUid
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && shopExists(shopId)
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'version', 'revision', 'totalCompletedSales',
            'saleCountsByProduct', 'pairCounts', 'processedSaleIds', 'updatedAt'
          ]);
        allow delete: if isOwner(shopId) && isValidId(cacheId) && cacheId == 'cooccurrence_v2' && shopExists(shopId) && existing().ownerUid == shopId;
      }

      // Public Storefront Metadata (Document ID: 'meta', Public get-only, Owner write)
      match /storefront/{metaId} {
        allow get: if isValidId(shopId) && metaId == 'meta';
        allow list: if false;
        allow create: if isOwner(shopId)
          && metaId == 'meta'
          && isValidStorefrontMeta(incoming(), shopId)
          && incoming().updatedAt == request.time
          && shopExists(shopId);
        allow update: if isOwner(shopId)
          && metaId == 'meta'
          && isValidStorefrontMeta(incoming(), shopId)
          && incoming().ownerUid == existing().ownerUid
          && incoming().updatedAt == request.time
          && shopExists(shopId)
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'shopName', 'phone', 'address', 'currency', 'updatedAt'
          ]);
        allow delete: if false;
      }

      // Public Sanitized Storefront Catalog (Zero cost/wholesale/profit/supplier fields)
      match /storefrontCatalog/{productId} {
        allow get: if isValidId(shopId) && isValidId(productId) && (resource == null || existing().ownerUid == shopId);
        allow list: if isValidId(shopId) && existing().ownerUid == shopId;
        allow create: if isOwner(shopId)
          && isValidId(productId)
          && isValidStorefrontCatalogItem(incoming(), shopId, productId)
          && incoming().updatedAt == request.time
          && shopExists(shopId);
        allow update: if isValidId(shopId)
          && isValidId(productId)
          && isValidStorefrontCatalogItem(incoming(), shopId, productId)
          && incoming().ownerUid == existing().ownerUid
          && incoming().productId == existing().productId
          && incoming().updatedAt == request.time
          && shopExists(shopId)
          && (
            (
              isOwner(shopId) && (
                incoming().diff(existing()).affectedKeys().hasOnly([
                  'name', 'category', 'brand', 'salePrice', 'currentStock',
                  'unit', 'baseUnit', 'packagingUnits', 'image', 'isActive', 'updatedAt'
                ]) ||
                incoming().diff(existing()).affectedKeys().hasOnly(['currentStock', 'updatedAt'])
              )
            ) ||
            (
              existing().isActive == true
              && incoming().diff(existing()).affectedKeys().hasOnly(['currentStock', 'updatedAt'])
              && incoming().currentStock < existing().currentStock
              && incoming().currentStock >= 0
            )
          );
        allow delete: if isOwner(shopId) && isValidId(productId) && shopExists(shopId) && existing().ownerUid == shopId;
      }

      // Customer COD Website Orders (Public create-only headers; zero public read/update/delete)
      // Each line item is stored and individually validated in subcollection /websiteOrders/{orderId}/items/{itemId}.
      match /websiteOrders/{orderId} {
        allow get: if isValidId(orderId) && (
          (isOwner(shopId) && (resource == null || (shopExists(shopId) && existing().ownerUid == shopId))) ||
          (staffCanAddSales(shopId) && shopExists(shopId) && (resource == null || existing().ownerUid == shopId))
        );
        allow list: if (isOwner(shopId) && existing().ownerUid == shopId)
          || (staffCanAddSales(shopId) && existing().ownerUid == shopId);
        allow create: if isValidId(shopId)
          && isValidId(orderId)
          && isValidWebsiteOrderCreate(incoming(), shopId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && shopExists(shopId);
        allow update: if isValidId(shopId)
          && isValidId(orderId)
          && isValidWebsiteOrderUpdate(incoming(), shopId)
          && existing().ownerUid == shopId
          && incoming().ownerUid == existing().ownerUid
          && incoming().shopId == existing().shopId
          && incoming().orderNumber == existing().orderNumber
          && incoming().customerName == existing().customerName
          && incoming().customerPhone == existing().customerPhone
          && incoming().customerAddress == existing().customerAddress
          && incoming().customerNotes == existing().customerNotes
          && incoming().paymentMethod == existing().paymentMethod
          && (!('items' in incoming()) || ('items' in existing() && incoming().items == existing().items))
          && incoming().itemCount == existing().itemCount
          && incoming().totalQuantity == existing().totalQuantity
          && incoming().subtotal == existing().subtotal
          && incoming().deliveryFee == existing().deliveryFee
          && incoming().totalAmount == existing().totalAmount
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && shopExists(shopId)
          && (
            (
              isOwner(shopId)
              && existing().status == 'Pending Confirmation'
              && incoming().status == 'Confirmed'
              && incoming().diff(existing()).affectedKeys().hasOnly([
                'status', 'linkedSaleId', 'linkedSaleNumber', 'confirmedBy', 'confirmedByName', 'confirmedAt', 'updatedAt'
              ])
              && ('linkedSaleId' in incoming())
              && existsAfter(/databases/$(database)/documents/shops/$(shopId)/sales/$(incoming().linkedSaleId))
            ) ||
            (
              isOwner(shopId)
              && existing().status in ['Pending Confirmation', 'Confirmed', 'Out for Delivery']
              && incoming().status == 'Cancelled/Rejected'
              && incoming().diff(existing()).affectedKeys().hasOnly([
                'status', 'rejectionReason', 'cancelledAt', 'updatedAt'
              ])
            ) ||
            (
              (isOwner(shopId) || staffCanAddSales(shopId))
              && existing().status == 'Confirmed'
              && incoming().status == 'Out for Delivery'
              && incoming().diff(existing()).affectedKeys().hasOnly([
                'status', 'outForDeliveryAt', 'updatedAt'
              ])
            ) ||
            (
              (isOwner(shopId) || staffCanAddSales(shopId))
              && existing().status in ['Confirmed', 'Out for Delivery']
              && incoming().status == 'Delivered'
              && incoming().diff(existing()).affectedKeys().hasOnly([
                'status', 'deliveredAt', 'updatedAt'
              ])
            )
          );
        allow delete: if false;

        match /items/{itemId} {
          allow get: if isValidId(itemId) && (
            (isOwner(shopId) && (resource == null || (shopExists(shopId) && existing().ownerUid == shopId))) ||
            (staffCanAddSales(shopId) && shopExists(shopId) && (resource == null || existing().ownerUid == shopId))
          );
          allow list: if (isOwner(shopId) && existing().ownerUid == shopId)
            || (staffCanAddSales(shopId) && existing().ownerUid == shopId);
          allow create: if isValidId(shopId)
            && isValidId(orderId)
            && isValidId(itemId)
            && isValidWebsiteOrderItemDoc(incoming(), shopId, orderId)
            && incoming().createdAt == request.time
            && shopExists(shopId)
            && getAfter(/databases/$(database)/documents/shops/$(shopId)/websiteOrders/$(orderId)).data.ownerUid == shopId
            && getAfter(/databases/$(database)/documents/shops/$(shopId)/websiteOrders/$(orderId)).data.status == 'Pending Confirmation';
          allow update, delete: if false;
        }
      }
    }
  }
}
