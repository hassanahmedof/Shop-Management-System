    "StockAdjustment": {
      "title": "StockAdjustment",
      "description": "Explicit manual stock adjustment record for additions, reductions, damaged, expired, or missing goods.",
      "type": "object",
      "properties": {
        "ownerUid": { "type": "string", "maxLength": 128 },
        "productId": { "type": "string", "maxLength": 128 },
        "productName": { "type": "string", "maxLength": 180 },
        "adjustmentDate": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$", "maxLength": 10 },
        "adjustmentType": { "type": "string", "enum": ["add", "reduce", "damaged", "expired", "missing"] },
        "quantity": { "type": "number" },
        "reason": { "type": "string", "minLength": 1, "maxLength": 200 },
        "notes": { "type": "string", "maxLength": 500 },
        "previousStock": { "type": "number" },
        "newStock": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "ownerUid", "productId", "productName", "adjustmentDate", "adjustmentType",
        "quantity", "reason", "notes", "previousStock", "newStock", "createdAt"
      ]
    },
    "AuditLog": {
      "title": "AuditLog",
      "description": "Immutable audit trail of critical business mutations.",
      "type": "object",
      "properties": {
        "ownerUid": { "type": "string", "maxLength": 128 },
        "action": { "type": "string", "minLength": 1, "maxLength": 80 },
        "entityType": { "type": "string", "minLength": 1, "maxLength": 60 },
        "entityId": { "type": "string", "maxLength": 128 },
        "summary": { "type": "string", "minLength": 1, "maxLength": 400 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ownerUid", "action", "entityType", "entityId", "summary", "createdAt"]
    },
    "BackupRecord": {
      "title": "BackupRecord",
      "description": "Metadata record for shop data backups.",
      "type": "object",
      "properties": {
        "ownerUid": { "type": "string", "maxLength": 128 },
        "backupType": { "type": "string", "enum": ["automatic", "manual"] },
        "recordCount": { "type": "number" },
        "notes": { "type": "string", "maxLength": 300 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ownerUid", "backupType", "recordCount", "notes", "createdAt"]
    },
    "GoogleSheetsIntegration": {
      "title": "GoogleSheetsIntegration",
      "description": "Owner-only Google Sheets sync configuration and status metadata (never stores OAuth tokens or secrets).",
      "type": "object",
      "properties": {
        "ownerUid": { "type": "string", "maxLength": 128 },
        "spreadsheetId": { "type": "string", "maxLength": 180 },
        "spreadsheetUrl": { "type": "string", "maxLength": 350 },
        "spreadsheetTitle": { "type": "string", "maxLength": 180 },
        "autoSyncEnabled": { "type": "boolean" },
        "connectionState": { "type": "string", "enum": ["connected", "disconnected", "error"] },
        "lastSyncAt": { "type": "string", "maxLength": 64 },
        "lastSyncStatus": { "type": "string", "enum": ["idle", "syncing", "synced", "error"] },
        "lastError": { "type": "string", "maxLength": 500 },
        "syncedRecordCount": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "ownerUid", "spreadsheetId", "spreadsheetUrl", "spreadsheetTitle",
        "autoSyncEnabled", "connectionState", "lastSyncAt", "lastSyncStatus",
        "lastError", "syncedRecordCount", "createdAt", "updatedAt"
      ]
    },
    "SheetsSyncJob": {
      "title": "SheetsSyncJob",
      "description": "Persistent background retry queue job for failed or pending Google Sheets worksheet synchronizations.",
      "type": "object",
      "properties": {
        "ownerUid": { "type": "string", "maxLength": 128 },
        "jobType": { "type": "string", "enum": ["incremental", "full"] },
        "targetSheets": { "type": "array" },
        "recordCount": { "type": "number" },
        "status": { "type": "string", "enum": ["pending", "failed"] },
        "retryCount": { "type": "number" },
        "lastError": { "type": "string", "maxLength": 500 },
        "summary": { "type": "string", "maxLength": 300 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "ownerUid", "jobType", "targetSheets", "recordCount",
        "status", "retryCount", "lastError", "summary", "createdAt", "updatedAt"
      ]
    }
  },
