rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global safety net: default deny everything
    match /{document=**} {
      allow read, write: if false;
    }

    // ------------------------------------------------------------------
    // Global Hardened Helpers
    // ------------------------------------------------------------------
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwnerAuthUser() {
      return isSignedIn()
        && request.auth.token.firebase.sign_in_provider in ['password', 'google.com']
        && request.auth.token.email is string
        && request.auth.token.email.size() >= 3
        && !request.auth.token.email.lower().matches('.*@staff\\.caremart\\.app$');
    }

    function isStaffPasswordUser() {
      return isSignedIn() && request.auth.token.firebase.sign_in_provider == 'password';
    }

    function isNotStaffAccount(uid) {
      return !exists(/databases/$(database)/documents/staffAuthMap/$(uid));
    }

    function isOwnerSetupAuthorizedFor(uid) {
      return (
        exists(/databases/$(database)/documents/appState/ownerSetup) &&
        get(/databases/$(database)/documents/appState/ownerSetup).data.ownerUid == uid
      ) || (
        !exists(/databases/$(database)/documents/appState/ownerSetup) &&
        existsAfter(/databases/$(database)/documents/appState/ownerSetup) &&
        getAfter(/databases/$(database)/documents/appState/ownerSetup).data.ownerUid == uid
      );
    }

    function gateSecret() {
      return 'cm_gate_7d3e9a2c4f1b8e6092c4a1d7f5b8e301';
    }

    function isAuthorizedAdminDoc(uid) {
      return exists(/databases/$(database)/documents/admins/$(uid))
        && get(/databases/$(database)/documents/admins/$(uid)).data.role == 'owner'
        && get(/databases/$(database)/documents/admins/$(uid)).data.email == request.auth.token.email.lower();
    }

    function isAddedAdminOf(shopId) {
      return isOwnerAuthUser()
        && isNotStaffAccount(request.auth.uid)
        && exists(/databases/$(database)/documents/adminAuthMap/$(request.auth.uid))
        && get(/databases/$(database)/documents/adminAuthMap/$(request.auth.uid)).data.shopId == shopId
        && get(/databases/$(database)/documents/adminAuthMap/$(request.auth.uid)).data.isActive == true
        && exists(/databases/$(database)/documents/shops/$(shopId)/adminMembers/$(
          get(/databases/$(database)/documents/adminAuthMap/$(request.auth.uid)).data.adminMemberId
        ))
        && get(/databases/$(database)/documents/shops/$(shopId)/adminMembers/$(
          get(/databases/$(database)/documents/adminAuthMap/$(request.auth.uid)).data.adminMemberId
        )).data.isActive == true
        && get(/databases/$(database)/documents/shops/$(shopId)/adminMembers/$(
          get(/databases/$(database)/documents/adminAuthMap/$(request.auth.uid)).data.adminMemberId
        )).data.authUid == request.auth.uid;
    }

    function isOwner(shopId) {
      return isOwnerAuthUser()
        && isNotStaffAccount(request.auth.uid)
        && (
          (request.auth.uid == shopId && isAuthorizedAdminDoc(request.auth.uid)) ||
          isAddedAdminOf(shopId)
        );
    }

    function isPrimaryOwner(shopId) {
      return isOwnerAuthUser()
        && isNotStaffAccount(request.auth.uid)
        && request.auth.uid == shopId
        && isAuthorizedAdminDoc(request.auth.uid);
    }

    function shopExists(shopId) {
      return exists(/databases/$(database)/documents/shops/$(shopId));
    }

    function isActiveStaffOf(shopId) {
      return isStaffPasswordUser()
        && exists(/databases/$(database)/documents/staffAuthMap/$(request.auth.uid))
        && get(/databases/$(database)/documents/staffAuthMap/$(request.auth.uid)).data.shopId == shopId
        && get(/databases/$(database)/documents/staffAuthMap/$(request.auth.uid)).data.isActive == true;
    }

    function staffCanAddSales(shopId) {
      return isActiveStaffOf(shopId)
        && get(/databases/$(database)/documents/shops/$(shopId)/staff/$(
          get(/databases/$(database)/documents/staffAuthMap/$(request.auth.uid)).data.staffId
        )).data.isActive == true
        && get(/databases/$(database)/documents/shops/$(shopId)/staff/$(
          get(/databases/$(database)/documents/staffAuthMap/$(request.auth.uid)).data.staffId
        )).data.permissions.canAddSales == true;
    }

    function isValidDateStr(d) {
      return d is string && d.size() == 10 && d.matches('^\\d{4}-\\d{2}-\\d{2}$');
    }

    function isValidOptionalDateStr(d) {
      return d is string && (d == '' || (d.size() == 10 && d.matches('^\\d{4}-\\d{2}-\\d{2}$')));
    }

    function isValidPaymentMethod(m) {
      return m is string && m in ['Cash', 'Online'];
    }

    // ------------------------------------------------------------------
    // Entity Validation Blueprints
    // ------------------------------------------------------------------
    function isValidOwnerSetupState(data) {
      return data.keys().hasAll(['ownerUid', 'initialized', 'createdAt'])
        && data.keys().hasOnly(['ownerUid', 'initialized', 'createdAt'])
        && data.ownerUid is string && data.ownerUid == request.auth.uid && isValidId(data.ownerUid)
        && data.initialized == true
        && data.createdAt is timestamp;
    }

    function isValidAdminRecord(data) {
      return data.keys().hasAll(['uid', 'email', 'role', 'ownerProof', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'email', 'role', 'ownerProof', 'createdAt', 'updatedAt'])
        && data.uid is string && data.uid == request.auth.uid && data.uid.size() <= 128
        && data.email is string && data.email == request.auth.token.email.lower() && data.email.size() <= 200
        && data.role == 'owner'
        && data.ownerProof is string && data.ownerProof.size() == 64
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid', 'displayName', 'email', 'role', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'displayName', 'email', 'role', 'createdAt', 'updatedAt'])
        && data.uid is string && data.uid == request.auth.uid && data.uid.size() <= 128
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 120
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 200
        && data.role is string && data.role in ['owner', 'admin']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidShop(data) {
      return data.keys().hasAll(['ownerUid', 'shopName', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['ownerUid', 'shopName', 'createdAt', 'updatedAt'])
        && data.ownerUid is string && data.ownerUid == request.auth.uid && data.ownerUid.size() <= 128
        && data.shopName is string && data.shopName.size() >= 1 && data.shopName.size() <= 150
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidShopSettings(data, shopId) {
      return data.keys().hasAll([
          'ownerUid', 'shopName', 'ownerName', 'phone', 'address',
          'currency', 'timezone', 'dateFormat', 'language',
          'expiryAlertDays', 'autoBackupEnabled', 'lastBackupAt',
          'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerUid', 'shopName', 'ownerName', 'phone', 'address',
          'currency', 'timezone', 'dateFormat', 'language',
          'expiryAlertDays', 'autoBackupEnabled', 'lastBackupAt',
          'createdAt', 'updatedAt'
        ])
        && data.ownerUid is string && data.ownerUid == shopId && data.ownerUid.size() <= 128
        && data.shopName is string && data.shopName.size() >= 1 && data.shopName.size() <= 150
        && data.ownerName is string && data.ownerName.size() <= 120
        && data.phone is string && data.phone.size() <= 40
        && data.address is string && data.address.size() <= 300
        && data.currency == 'PKR'
        && data.timezone == 'Asia/Karachi'
        && data.dateFormat == 'DD-MM-YYYY'
        && data.language == 'English'
        && data.expiryAlertDays is number && data.expiryAlertDays >= 1 && data.expiryAlertDays <= 365
        && data.autoBackupEnabled is bool
        && data.lastBackupAt is string && data.lastBackupAt.size() <= 64
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidAdminMember(data, shopId) {
      return data.keys().hasAll([
          'ownerUid', 'shopId', 'shopCode', 'name', 'phone',
          'username', 'usernameLower', 'authUid', 'loginVersion',
          'role', 'isActive', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerUid', 'shopId', 'shopCode', 'name', 'phone',
          'username', 'usernameLower', 'authUid', 'loginVersion',
          'role', 'isActive', 'createdAt', 'updatedAt'
        ])
        && data.ownerUid is string && data.ownerUid == shopId && data.ownerUid.size() <= 128
        && data.shopId is string && data.shopId == shopId && data.shopId.size() <= 128
        && data.shopCode is string && data.shopCode.size() >= 4 && data.shopCode.size() <= 20
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 120
        && data.phone is string && data.phone.size() <= 40
        && data.username is string && data.username.size() >= 2 && data.username.size() <= 40
        && data.usernameLower is string && data.usernameLower.size() >= 2 && data.usernameLower.size() <= 40
        && data.authUid is string && data.authUid.size() >= 1 && data.authUid.size() <= 128
        && data.loginVersion is number && data.loginVersion >= 1
        && data.role == 'admin'
        && data.isActive is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidAdminLookup(data) {
      return data.keys().hasAll(['ownerUid', 'shopId', 'adminMemberId', 'loginVersion', 'isActive', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['ownerUid', 'shopId', 'adminMemberId', 'loginVersion', 'isActive', 'createdAt', 'updatedAt'])
        && data.ownerUid is string && data.ownerUid == data.shopId && data.ownerUid.size() <= 128
        && data.shopId is string && isValidId(data.shopId)
        && data.adminMemberId is string && isValidId(data.adminMemberId)
        && data.loginVersion is number && data.loginVersion >= 1
        && data.isActive is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidAdminAuthMap(data) {
      return data.keys().hasAll(['ownerUid', 'shopId', 'adminMemberId', 'isActive', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['ownerUid', 'shopId', 'adminMemberId', 'isActive', 'createdAt', 'updatedAt'])
        && data.ownerUid is string && data.ownerUid == data.shopId && data.ownerUid.size() <= 128
        && data.shopId is string && isValidId(data.shopId)
        && data.adminMemberId is string && isValidId(data.adminMemberId)
        && data.isActive is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidStaffPermissions(perms) {
      return perms is map
        && perms.keys().hasAll(['canAddSales', 'canViewOwnSales', 'canViewStock'])
        && perms.keys().hasOnly(['canAddSales', 'canViewOwnSales', 'canViewStock'])
        && perms.canAddSales is bool
        && perms.canViewOwnSales is bool
        && perms.canViewStock is bool;
    }

    function isValidStaffMember(data, shopId) {
      return data.keys().hasAll([
          'ownerUid', 'shopId', 'shopCode', 'name', 'phone',
          'username', 'usernameLower', 'authUid', 'loginVersion',
          'role', 'isActive', 'permissions', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerUid', 'shopId', 'shopCode', 'name', 'phone',
          'username', 'usernameLower', 'authUid', 'loginVersion',
          'role', 'isActive', 'permissions', 'createdAt', 'updatedAt'
        ])
        && data.ownerUid is string && data.ownerUid == shopId && data.ownerUid.size() <= 128
        && data.shopId is string && data.shopId == shopId && data.shopId.size() <= 128
        && data.shopCode is string && data.shopCode.size() >= 4 && data.shopCode.size() <= 20
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 120
        && data.phone is string && data.phone.size() <= 40
        && data.username is string && data.username.size() >= 2 && data.username.size() <= 40
        && data.usernameLower is string && data.usernameLower.size() >= 2 && data.usernameLower.size() <= 40
        && data.authUid is string && data.authUid.size() >= 1 && data.authUid.size() <= 128
        && data.loginVersion is number && data.loginVersion >= 1
        && data.role in ['sales_staff', 'staff']
        && data.isActive is bool
        && isValidStaffPermissions(data.permissions)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidStaffLookup(data) {
      return data.keys().hasAll(['ownerUid', 'shopId', 'staffId', 'loginVersion', 'isActive', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['ownerUid', 'shopId', 'staffId', 'loginVersion', 'isActive', 'createdAt', 'updatedAt'])
        && data.ownerUid is string && data.ownerUid == data.shopId && data.ownerUid.size() <= 128
        && data.shopId is string && isValidId(data.shopId)
        && data.staffId is string && isValidId(data.staffId)
        && data.loginVersion is number && data.loginVersion >= 1
        && data.isActive is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidStaffAuthMap(data) {
      return data.keys().hasAll(['ownerUid', 'shopId', 'staffId', 'isActive', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['ownerUid', 'shopId', 'staffId', 'isActive', 'createdAt', 'updatedAt'])
        && data.ownerUid is string && data.ownerUid == data.shopId && data.ownerUid.size() <= 128
        && data.shopId is string && isValidId(data.shopId)
        && data.staffId is string && isValidId(data.staffId)
        && data.isActive is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidStaffCatalogItem(data, shopId) {
      return data.keys().hasAll([
          'ownerUid', 'productId', 'name', 'categoryName', 'brandName',
          'salePrice', 'currentStock', 'unit', 'isActive', 'allowedStaffUids', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerUid', 'productId', 'name', 'categoryName', 'brandName',
          'salePrice', 'wholesalePrice', 'currentStock', 'unit', 'baseUnit', 'packagingUnits',
          'originType', 'bottleSize', 'storageLocation', 'isReturnable', 'returnableUnitName', 'depositPerReturnable',
          'isActive', 'allowedStaffUids', 'updatedAt'
        ])
        && data.ownerUid is string && data.ownerUid == shopId && data.ownerUid.size() <= 128
        && data.productId is string && isValidId(data.productId)
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 180
        && data.categoryName is string && data.categoryName.size() <= 100
        && data.brandName is string && data.brandName.size() <= 100
        && data.salePrice is number && data.salePrice >= 0
        && (!('wholesalePrice' in data) || (data.wholesalePrice is number && data.wholesalePrice >= 0))
        && data.currentStock is number && data.currentStock >= 0
        && data.unit is string && data.unit.size() >= 1 && data.unit.size() <= 40
        && (!('baseUnit' in data) || (data.baseUnit is string && data.baseUnit.size() >= 1 && data.baseUnit.size() <= 40))
        && (!('packagingUnits' in data) || (data.packagingUnits is list && data.packagingUnits.size() <= 25 && (data.packagingUnits.size() == 0 || data.packagingUnits[0] is map)))
        && (!('originType' in data) || (data.originType is string && data.originType in ['', 'local', 'imported']))
        && (!('bottleSize' in data) || (data.bottleSize is string && data.bottleSize.size() <= 40))
        && (!('storageLocation' in data) || (data.storageLocation is string && data.storageLocation.size() <= 80))
        && (!('isReturnable' in data) || data.isReturnable is bool)
        && (!('returnableUnitName' in data) || (data.returnableUnitName is string && data.returnableUnitName.size() <= 40))
        && (!('depositPerReturnable' in data) || (data.depositPerReturnable is number && data.depositPerReturnable >= 0))
        && data.isActive is bool
        && data.allowedStaffUids is list && data.allowedStaffUids.size() <= 50
        && (data.allowedStaffUids.size() == 0 || data.allowedStaffUids[0] is string)
        && data.updatedAt is timestamp;
    }

    function isValidStaffSale(data, shopId) {
      return data.keys().hasAll([
          'ownerUid', 'shopId', 'saleNumber', 'saleDate', 'saleDateTime', 'paymentMethod',
          'totalAmount', 'totalQuantity', 'itemCount', 'items', 'staffId', 'staffAuthUid',
          'staffName', 'staffUsername', 'notes', 'status', 'syncedToLedger', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerUid', 'shopId', 'saleNumber', 'saleDate', 'saleDateTime', 'paymentMethod',
          'totalAmount', 'totalQuantity', 'itemCount', 'items', 'staffId', 'staffAuthUid',
          'staffName', 'staffUsername', 'customerWhatsapp', 'notes', 'status', 'syncedToLedger', 'createdAt', 'updatedAt'
        ])
        && data.ownerUid is string && data.ownerUid == shopId && data.ownerUid.size() <= 128
        && data.shopId is string && data.shopId == shopId && data.shopId.size() <= 128
        && data.saleNumber is string && data.saleNumber.size() >= 1 && data.saleNumber.size() <= 40
        && isValidDateStr(data.saleDate)
        && data.saleDateTime is string && data.saleDateTime.size() >= 10 && data.saleDateTime.size() <= 30
        && isValidPaymentMethod(data.paymentMethod)
        && data.totalAmount is number && data.totalAmount >= 0
        && data.totalQuantity is number && data.totalQuantity > 0
        && data.itemCount is number && data.itemCount >= 1 && data.itemCount <= 200
        && data.items is list && data.items.size() >= 1 && data.items.size() <= 200 && data.items[0] is map
        && data.staffId is string && isValidId(data.staffId)
        && data.staffAuthUid is string && isValidId(data.staffAuthUid)
        && data.staffName is string && data.staffName.size() >= 1 && data.staffName.size() <= 120
        && data.staffUsername is string && data.staffUsername.size() >= 2 && data.staffUsername.size() <= 40
        && (!('customerWhatsapp' in data) || data.customerWhatsapp == null || (data.customerWhatsapp is string && data.customerWhatsapp.size() <= 32))
        && data.notes is string && data.notes.size() <= 500
        && data.status is string && data.status in ['completed', 'cancelled']
        && data.syncedToLedger is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidCategory(data, shopId) {
      return data.keys().hasAll(['ownerUid', 'name', 'description', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['ownerUid', 'name', 'description', 'createdAt', 'updatedAt'])
        && data.ownerUid is string && data.ownerUid == shopId && data.ownerUid.size() <= 128
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 100
        && data.description is string && data.description.size() <= 300
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidBrand(data, shopId) {
      return data.keys().hasAll(['ownerUid', 'name', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['ownerUid', 'name', 'categoryIds', 'isActive', 'createdAt', 'updatedAt'])
        && data.ownerUid is string && data.ownerUid == shopId && data.ownerUid.size() <= 128
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 100
        && (!('categoryIds' in data) || (data.categoryIds is list && data.categoryIds.size() <= 25 && (data.categoryIds.size() == 0 || data.categoryIds[0] is string)))
        && (!('isActive' in data) || data.isActive is bool)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidSupplier(data, shopId) {
      return data.keys().hasAll([
          'ownerUid', 'name', 'phone', 'address',
          'totalPurchased', 'totalPaid', 'outstandingBalance', 'notes',
          'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerUid', 'name', 'phone', 'address', 'email',
          'totalPurchased', 'totalPaid', 'outstandingBalance', 'notes',
          'createdAt', 'updatedAt'
        ])
        && data.ownerUid is string && data.ownerUid == shopId && data.ownerUid.size() <= 128
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 150
        && data.phone is string && data.phone.size() <= 40
        && data.address is string && data.address.size() <= 300
        && (!('email' in data) || (data.email is string && data.email.size() <= 200))
        && data.totalPurchased is number && data.totalPurchased >= 0
        && data.totalPaid is number && data.totalPaid >= 0
        && data.outstandingBalance is number && data.outstandingBalance >= 0
        && data.notes is string && data.notes.size() <= 500
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidProduct(data, shopId) {
      return data.keys().hasAll([
          'ownerUid', 'name', 'categoryId', 'categoryName', 'brandId', 'brandName',
          'purchasePrice', 'salePrice', 'wholesalePrice',
          'currentStock', 'minStockLevel', 'maxStockLevel',
          'unit', 'supplierId', 'supplierName', 'expiryDate', 'profitMarginPct',
          'isActive', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerUid', 'name', 'categoryId', 'categoryName', 'brandId', 'brandName',
          'purchasePrice', 'salePrice', 'wholesalePrice',
          'currentStock', 'minStockLevel', 'maxStockLevel',
          'unit', 'baseUnit', 'packagingUnits', 'originType', 'bottleSize', 'storageLocation',
          'isReturnable', 'returnableUnitName', 'depositPerReturnable', 'emptyContainersOnHand',
          'supplierId', 'supplierName', 'expiryDate', 'profitMarginPct', 'image',
          'isActive', 'createdAt', 'updatedAt'
        ])
        && data.ownerUid is string && data.ownerUid == shopId && data.ownerUid.size() <= 128
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 180
        && data.categoryId is string && data.categoryId.size() <= 128
        && data.categoryName is string && data.categoryName.size() <= 100
        && data.brandId is string && data.brandId.size() <= 128
        && data.brandName is string && data.brandName.size() <= 100
        && data.purchasePrice is number && data.purchasePrice >= 0
        && data.salePrice is number && data.salePrice >= 0
        && data.wholesalePrice is number && data.wholesalePrice >= 0
        && data.currentStock is number && data.currentStock >= 0
        && data.minStockLevel is number && data.minStockLevel >= 0
        && data.maxStockLevel is number && data.maxStockLevel >= 0
        && data.unit is string && data.unit.size() >= 1 && data.unit.size() <= 40
        && (!('baseUnit' in data) || (data.baseUnit is string && data.baseUnit.size() >= 1 && data.baseUnit.size() <= 40))
        && (!('packagingUnits' in data) || (data.packagingUnits is list && data.packagingUnits.size() <= 25 && (data.packagingUnits.size() == 0 || data.packagingUnits[0] is map)))
        && (!('originType' in data) || (data.originType is string && data.originType in ['', 'local', 'imported']))
        && (!('bottleSize' in data) || (data.bottleSize is string && data.bottleSize.size() <= 40))
        && (!('storageLocation' in data) || (data.storageLocation is string && data.storageLocation.size() <= 80))
        && (!('isReturnable' in data) || data.isReturnable is bool)
        && (!('returnableUnitName' in data) || (data.returnableUnitName is string && data.returnableUnitName.size() <= 40))
        && (!('depositPerReturnable' in data) || (data.depositPerReturnable is number && data.depositPerReturnable >= 0))
        && (!('emptyContainersOnHand' in data) || (data.emptyContainersOnHand is number && data.emptyContainersOnHand >= 0))
        && data.supplierId is string && data.supplierId.size() <= 128
        && data.supplierName is string && data.supplierName.size() <= 150
        && isValidOptionalDateStr(data.expiryDate)
        && data.profitMarginPct is number && data.profitMarginPct >= -1000 && data.profitMarginPct <= 100
        && (!('image' in data) || (data.image is string && data.image.size() <= 500))
        && data.isActive is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidProductTemplate(data, shopId) {
      return data.keys().hasAll([
          'ownerUid', 'name', 'categoryId', 'categoryName', 'brandId', 'brandName',
          'variant', 'baseUnit', 'isActive', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerUid', 'name', 'categoryId', 'categoryName', 'brandId', 'brandName',
          'variant', 'originType', 'baseUnit', 'defaultPurchaseUnit', 'defaultSaleUnit',
          'packagingUnits', 'hasUnconfirmedPackaging',
          'suggestedPurchasePrice', 'suggestedSalePrice', 'suggestedWholesalePrice',
